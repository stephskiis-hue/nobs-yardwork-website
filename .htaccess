# ----------------------------------------------------------------------
# OPTIMIZED .HTACCESS FOR CACHING, GZIP, CLEAN URLS, RSS FIX
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# BROWSER CACHING (Expires headers)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Images: Cache for 1 year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS & JS: Cache for 1 year (use versioned filenames for updates)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Fonts: Cache for 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Video: Cache for 1 year
  ExpiresByType video/mp4 "access plus 1 year"

  # HTML pages: shorter cache (1 hour)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ----------------------------------------------------------------------
# CACHE-CONTROL HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Force cache for static assets
  <FilesMatch "\.(jpg|jpeg|gif|png|webp|svg|ico|css|js|woff|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Short cache for HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# JSON DATA FILES (posts.json etc.)
# ----------------------------------------------------------------------
AddType application/json .json
<FilesMatch "\.json$">
  Require all granted
  Header set Cache-Control "public, max-age=300"
  Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# ----------------------------------------------------------------------
# GZIP COMPRESSION
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  # Compress text, HTML, JS, CSS, XML, JSON, SVG
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# URL REWRITE ENGINE
# ----------------------------------------------------------------------
RewriteEngine On

# ----------------------------------------------------------------------
# 2. REMOVE .HTML FROM URL IF EXPLICITLY TYPED
# ----------------------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# ----------------------------------------------------------------------
# 301 REDIRECTS
# ----------------------------------------------------------------------
Redirect 301 /lawn-mowing-winnipeg.html https://www.no-bs-yardwork.com/grass-cutting-winnipeg.html

# WordPress post redirects (WP /blog/ folder removed 2026-04-20)
# Using RewriteRule for exact matching — avoids mod_alias prefix-match side effects
RewriteRule ^blog/spring-cleanup-march-may/?$ /blog-spring-cleanup-winnipeg [R=301,L]
RewriteRule ^blog/you-know-what-that-means-spring-is-officially-here/?$ /blog-spring-cleanup-winnipeg [R=301,L]
RewriteRule ^blog/no-bs-yardwork-becomes-the-best-spring-clean-up-company-in-winnipeg/?$ /blog-spring-cleanup-winnipeg [R=301,L]
RewriteRule ^blog/keeping-the-best-yard-on-your-street-is-a-mix-of-consistent-care/?$ /blog-spring-lawn-tips-winnipeg [R=301,L]
RewriteRule ^blog/how-do-i-maintain-my-grass-to-stay-green-and-healthy/?$ /blog-lawn-aeration-winnipeg [R=301,L]
RewriteRule ^blog/benefits-of-weed-control-on-your-yard/?$ /weed-control-winnipeg [R=301,L]
RewriteRule ^blog/the-importance-of-proper-lawn-maintenance/?$ /lawn-care-winnipeg [R=301,L]
RewriteRule ^blog/stone-hardscape-services/?$ /landscaping-winnipeg [R=301,L]
RewriteRule ^blog/landscape-concrete-paving-ideas/?$ /landscaping-winnipeg [R=301,L]
RewriteRule ^blog/how-do-i-choose-the-best-landscaping-company/?$ /landscaping-winnipeg [R=301,L]
RewriteRule ^blog/why-living-in-winnipeg-manitoba-is-so-amazing/?$ / [R=301,L]
RewriteRule ^blog/about-no-bs/?$ /about [R=301,L]
# /blog and /blog/ both serve blog.html (no redirect chain)
RewriteRule ^blog/?$ /blog.html [L]

# ----------------------------------------------------------------------
# 3. CLEAN URL INTERNAL MAPPING
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# ----------------------------------------------------------------------
# 4. OPTIONAL: Custom 404 Page
# ----------------------------------------------------------------------
# ErrorDocument 404 /404.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php70” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php70 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
