# Twilio SMS bridge for weekly SEO audit
# Copy to _seo-twilio.env and fill in. DO NOT commit _seo-twilio.env.

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # Your Twilio phone number (must be SMS-capable)
TWILIO_TO_NUMBER=+12049000438     # Your personal phone (Steph's)
