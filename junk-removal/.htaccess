# ----------------------------------------------------------------------
# no-bsjunk.com
#
# Mirrors the conventions on no-bs-yardwork.com: extensionless URLs, long
# cache on static assets, short cache on HTML, gzip.
#
# This file works in both hosting arrangements:
#   - as the document root of an addon domain  (the intended setup)
#   - as a subdirectory of no-bs-yardwork.com  (the fallback, works today)
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# BROWSER CACHING
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|css|js|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# SECURITY HEADERS
#
# Cheap, standards-based, and they cost nothing to serve. No CSP here on
# purpose: this site loads Google Tag Manager, GA4 and Google Fonts, and a CSP
# written without testing against all three is a quick way to silently break
# analytics or the quote form.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Stop browsers guessing a MIME type and executing something as script.
  Header always set X-Content-Type-Options "nosniff"
  # Send the origin on cross-site requests, full URL same-site. Keeps referral
  # data useful in analytics without leaking full paths to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # This site asks for no camera, microphone or location. Say so.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------------------
# GZIP
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# URL REWRITING
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# Source fragments and container config are not part of the site. This is
# FIRST on purpose: the .html-stripping rule below would otherwise 301
# /_pages/foo.html to /_pages/foo before the deny was ever considered, which
# ends in the same 403 but advertises the directory layout on the way.
RewriteRule ^(_pages|deploy)/ - [F,L]

# ......................................................................
# CANONICAL HOST
#
# Live since 2026-09-23: no-bsjunk.com resolves through Cloudflare to this
# server. The canonical host is the BARE domain, because Cloudflare already
# 301s www -> no-bsjunk.com at its edge. The rule below says the same thing at
# the origin, for requests that reach Apache another way (the subdirectory copy
# on no-bs-yardwork.com, or the server's own hostname).
#
# Point it at www and the site becomes unreachable: Cloudflare sends www to the
# apex, Apache sends the apex back to www, and the browser gives up after about
# twenty hops. If Cloudflare's redirect rule is ever flipped to prefer www,
# flip this line and SITE in _build.py together, or the loop comes back.
#
# HTTPS is not forced here either — Cloudflare redirects http to https before
# a request reaches Apache, and doing it in both places is the other common
# way to build a loop.
# ......................................................................
RewriteCond %{HTTP_HOST} ^www\.no-bsjunk\.com$ [NC]
RewriteRule ^(.*)$ https://no-bsjunk.com/$1 [R=301,L]

# Strip .html when it is typed or linked explicitly.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Map the extensionless URL back to the file on disk.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]
</IfModule>

# ----------------------------------------------------------------------
# 404
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Keep build tooling and docs off the public web.
#
# DEPLOY.md tells people not to upload any of this, but belt and braces: a
# File Manager drag-and-drop takes the whole folder more often than not.
#
# Wrapped in an IfModule because `Require` is Apache 2.4 syntax. On an older
# 2.2 server these directives would be a hard 500 rather than a no-op, which
# would take down the entire site over a hardening rule.
# ----------------------------------------------------------------------
<IfModule mod_authz_core.c>
  # Every Python file, matched by extension rather than by name. This used to
  # list _build.py and _make-icons.py individually, so _categories.py was
  # downloadable the moment it was added. Whatever .py file comes next is
  # covered without anyone having to remember this rule exists. The [cod] also
  # covers compiled .pyc files, in case a __pycache__ folder ever gets uploaded.
  <FilesMatch "\.py[cod]?$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(Dockerfile|railway\.json|\.dockerignore)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.md$">
    Require all denied
  </FilesMatch>
  # Nothing writes a lead log any more (the PHP handler is gone), but these
  # stay: a stray .env, .sql dump or editor .bak in a web root is a real way
  # to leak credentials, and denying them costs nothing.
  <FilesMatch "\.(log|bak|sql|env)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
