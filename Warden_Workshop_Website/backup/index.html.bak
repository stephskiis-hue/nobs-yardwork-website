    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Warden's Workshop",
      "description": "Master restoration and renovation services including painting, home renovation, RV revitalization, and vintage technical repair, serving Essex, ON since 1976.",
      "url": "https://wardensworkshop.ca",
      "logo": "https://wardensworkshop.ca/images/logo.png",
      "image": "https://wardensworkshop.ca/images/hero-bg.jpg",
      "telephone": "+18884880864",
      "email": "apwarden1@gmail.com",
      "foundingDate": "1976",
      "founder": {
        "@type": "Person",
        "name": "Tony Warden"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "509-22 Victor Street",
        "addressLocality": "Essex",
        "addressRegion": "ON",
        "addressCountry": "CA"
      },
      "areaServed": {
        "@type": "State",
        "name": "Ontario"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Workshop Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Painting & Exterior" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Home Renovation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "RV Revitalization" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Technical Services" } }
        ]
      }
    }
    </script>
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
