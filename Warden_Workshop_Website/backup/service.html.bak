            "description": "Interior and exterior painting, deck building and staining, fence installation, and power washing services.",
            "provider": { "@type": "LocalBusiness", "name": "Warden's Workshop" }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "Service",
            "name": "Home Renovation",
            "description": "Drywall repair and installation, kitchen and bathroom updates, flooring installation, and custom trim and carpentry.",
            "provider": { "@type": "LocalBusiness", "name": "Warden's Workshop" }
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "Service",
            "name": "RV Revitalization",
            "description": "Interior remodeling, leak repair and weatherproofing, system maintenance checks, and transportation services.",
            "provider": { "@type": "LocalBusiness", "name": "Warden's Workshop" }
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "item": {
            "@type": "Service",
            "name": "Technical Services",
