    <header class="page-header">
      <div class="container text-center reveal">
        <h1>Professional Services</h1>
        <p>Master-level execution across all disciplines.</p>
      </div>
    </header>

    <section class="section container">
      <div class="pricing-note reveal">
        <i class="fas fa-info-circle"></i>
        <p>
          <em>Servicing Prices updated as of January 2026. Contact us for custom quotes on unique projects.</em>
        </p>
      </div>

      <div class="service-grid">
        <div class="service-card reveal" id="painting">
          <img src="images/gallery-2.jpg" alt="Painting Services" />
          <div class="service-content">
            <h3>Painting &amp; Exterior</h3>
            <ul class="check-list">
              <li><i class="fas fa-check"></i> Interior &amp; Exterior Painting</li>
              <li><i class="fas fa-check"></i> Deck building &amp; staining</li>
              <li><i class="fas fa-check"></i> Fence installation</li>
              <li><i class="fas fa-check"></i> Power Washing Services</li>
            </ul>
          </div>
        </div>

        <div class="service-card reveal" id="renovation">
          <img src="images/renovation.jpg" alt="Renovation Services" />
          <div class="service-content">
            <h3>Home Renovation</h3>
            <ul class="check-list">
              <li><i class="fas fa-check"></i> Drywall repair &amp; install</li>
              <li><i class="fas fa-check"></i> Kitchen &amp; bathroom touches</li>
              <li><i class="fas fa-check"></i> Flooring installation</li>
              <li><i class="fas fa-check"></i> Custom trim &amp; carpentry</li>
            </ul>
          </div>
        </div>

        <div class="service-card reveal" id="rv">
          <img src="images/gallery-4.jpg" alt="RV Services" />
          <div class="service-content">
            <h3>RV Revitalization</h3>
            <ul class="check-list">
              <li><i class="fas fa-check"></i> Interior remodeling</li>
              <li><i class="fas fa-check"></i> Leak repair &amp; weatherproofing</li>
              <li><i class="fas fa-check"></i> System maintenance checks</li>
              <li><i class="fas fa-check"></i> Transportation Services</li>
            </ul>
          </div>
        </div>

        <div class="service-card reveal" id="technical">
          <img src="images/gallery-3.jpg" alt="Sewing Machine Services" />
          <div class="service-content">
            <h3>Technical Services</h3>
            <ul class="check-list">
              <li><i class="fas fa-check"></i> Vintage Sewing Restoration</li>
              <li><i class="fas fa-check"></i> Modern Machine Tuning</li>
              <li><i class="fas fa-check"></i> Flat-pack Furniture Assembly</li>
              <li><i class="fas fa-check"></i> Antique structural repair</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="text-center reveal" style="margin-top: 60px">
        <a href="contact.html" class="btn btn-primary">Request an Estimate</a>
      </div>
    </section>

    <footer>
      <div class="container footer-content">
        <div class="footer-info">
          <img src="images/logo.png" alt="Warden's Workshop Logo" class="footer-logo" />
          <p>© 2026 Warden's Workshop<br />509-22 Victor Street, Essex, ON</p>
        </div>
        <div class="footer-contact">
          <h4>Contact Tony</h4>
          <p><i class="fas fa-phone"></i><a href="tel:1-888-488-0864">1-888-488-0864</a></p>
          <p><i class="fas fa-envelope"></i><a href="mailto:apwarden1@gmail.com">apwarden1@gmail.com</a></p>
        </div>
      </div>
