        </div>
        <div class="footer-contact">
          <h4>Contact Tony</h4>
          <p><i class="fas fa-phone"></i><a href="tel:1-888-488-0864">1-888-488-0864</a></p>
          <p><i class="fas fa-envelope"></i><a href="mailto:apwarden1@gmail.com">apwarden1@gmail.com</a></p>
        </div>
      </div>
    </footer>

