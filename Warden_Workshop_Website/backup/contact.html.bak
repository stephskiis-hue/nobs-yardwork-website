    <header class="page-header">
      <div class="container text-center reveal">
        <h1>Let's Discuss Your Project</h1>
        <p>
          Whether it's a vintage restoration or a full property renovation,
          master craftsmanship is just a message away.
        </p>
      </div>
    </header>

    <section class="section container">
      <div class="contact-grid">
        <div class="reveal contact-info-box">
          <div class="section-title left-align">
            <h2>Get in Touch</h2>
            <div class="underline"></div>
          </div>

          <div class="contact-details">
            <div class="contact-item">
              <i class="fas fa-phone-alt"></i>
              <div>
                <p class="contact-label">Call Toll-Free</p>
                <a href="tel:1-888-488-0864">1-888-488-0864</a>
              </div>
            </div>

            <div class="contact-item">
              <i class="fas fa-envelope"></i>
              <div>
                <p class="contact-label">Email Tony</p>
                <a href="mailto:apwarden1@gmail.com">apwarden1@gmail.com</a>
              </div>
            </div>

            <div class="contact-item">
              <i class="fas fa-map-marker-alt"></i>
              <div>
                <p class="contact-label">Workshop Location</p>
                <p>509-22 Victor Street, Essex, ON</p>
              </div>
            </div>
          </div>

          <div class="map-container">
            <iframe
              src="https://maps.google.com/maps?q=509-22%20Victor%20Street,%20Essex,%20ON&t=&z=13&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="300"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
            ></iframe>
          </div>
        </div>

        <div class="card form-card reveal">
          <h3>Request an Estimate</h3>
          <p class="subtitle">
            Provide some details about your project, and Tony will reach out
            within 24–48 hours.
          </p>

          <form action="process.php" method="POST" class="custom-form">
            <div class="form-group">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" placeholder="John Doe" required />
            </div>

            <div class="form-group split-group">
              <div class="half-width">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="john@example.com" required />
              </div>
              <div class="half-width">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" />
              </div>
            </div>

            <div class="form-group">
              <label for="service">Service Needed</label>
              <select id="service" name="service">
                <option value="General Inquiry">General Inquiry</option>
                <option value="Painting & Exterior">Painting &amp; Exterior</option>
                <option value="Home Renovation">Home Renovation</option>
                <option value="RV Revitalization">RV Revitalization</option>
                <option value="Technical Services">Technical Services</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Project Details *</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Tell us about the piece you need restored or the property you need renovated..."
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary submit-btn">Send Message</button>
          </form>
        </div>
      </div>
    </section>

    <footer>
      <div class="container footer-content">
        <div class="footer-info">
          <img src="images/logo.png" alt="Warden's Workshop Logo" class="footer-logo" />
          <p>© 2026 Warden's Workshop<br />509-22 Victor Street, Essex, ON</p>
        </div>
        <div class="footer-contact">
          <h4>Contact Tony</h4>
          <p><i class="fas fa-phone"></i><a href="tel:1-888-488-0864">1-888-488-0864</a></p>
          <p><i class="fas fa-envelope"></i><a href="mailto:apwarden1@gmail.com">apwarden1@gmail.com</a></p>
        </div>
      </div>
    </footer>

    <script src="js/script.js"></script>
  </body>
